{
  "name": "game-theory-sandbox",
  "version": "0.22.3",
  "private": true,
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "next dev",
    "build": "node scripts/check-node.mjs && next build",
    "start": "serve -l 4002 --config ../serve.json out",
    "serve:export": "serve -l 4002 --config ../serve.json out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-engine-coverage.mjs",
    "check:invariants": "bash scripts/check-invariants.sh",
    "test:invariants": "node scripts/test-invariants.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "verify": "pnpm check:version && pnpm check:invariants && pnpm check:csp && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "verify:full": "pnpm verify && pnpm build && pnpm bundle:check && pnpm test:invariants && pnpm exec playwright test",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "author": "Sidakpreet Singh",
  "description": "Static interactive game-theory sandbox with exact analytical engines.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impreetentious/gt-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/impreetentious/gt-sandbox/issues"
  },
  "homepage": "https://github.com/impreetentious/gt-sandbox",
  "overrides": {
    "sharp": "0.35.4",
    "next": {
      "sharp": "0.35.4"
    },
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "browserslist@<=4.28.6": "4.28.7",
    "fast-uri@>=3.0.0 <3.1.8": "3.1.8"
  }
}
